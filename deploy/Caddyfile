# Альтернатива nginx: Caddy сам получает и продлевает сертификат Let's Encrypt,
# сам отдаёт precompressed-файлы. Ставится одной командой, конфиг короче.
# Правила канонизации те же: /en/ со слэшем, остальное — без.

kabanov.agency {
	root * /var/www/kabanov.agency
	encode gzip zstd

	# /en → /en/
	redir /en /en/ 301

	# /что-угодно/ → /что-угодно  (корни локалей не трогаем)
	@trailing {
		path_regexp trail ^(/.+)/$
		not path /en/
	}
	redir @trailing {re.trail.1} 301

	# /путь/index.html → /путь
	@indexhtml path_regexp idx ^(.*)/index\.html$
	redir @indexhtml {re.idx.1} 301

	# Имена в /assets содержат хеш сборки — кэшируем навсегда.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@pages not path /assets/*
	header @pages {
		Cache-Control "public, max-age=0, must-revalidate"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	# try_files с явным index.html: иначе file_server сам redirect'ит на слэш.
	try_files {path} {path}/index.html
	file_server

	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			# status 404 обязателен: без него Caddy отдаст страницу с кодом 200,
			# и поисковик проиндексирует её как обычную.
			file_server {
				status 404
			}
		}
	}
}

www.kabanov.agency {
	redir https://kabanov.agency{uri} 301
}
